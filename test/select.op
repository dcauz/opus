
i32 main( i32 argc, final string [] argv )
{
	class acct_h
  {
		string name;
		string? sin;
		string? address;
		i32		 account; 
  }

  relation acct = header acct_h
									primary key name dsc, address asc
									foreign key name = other.name
									unique sin
									unique account
									save by column
									source "/home/dcauz/opus/db/acct";
  
	mset<acct_h> na = select name, address from acct;

	set<acct_h> da = select distinct * from acct 
										where name ~ r"D*"
										group by sin, address
										having sum(account) > 1000000
										order by name dsc, sin asc
										offset 100 rows
										fetch first 100 rows only;

	return 0;
}
