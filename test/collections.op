
bool cmp( i32 a, i32 b )
{
	return b < a;
}

i32 main( i32 argc, final string [] argv )
{
	i32 [3,3]		matrix;

	matrix[0,1] = 1;

	////////////////////////////////
	i32 [3][3]	vecOfVec;

	vecOfVec[0][1] = 1;

	////////////////////////////////
	set<i32>		setI;

	setI.add(1);
	setI.add(1);

	////////////////////////////////
	mset<i32>		msetI;

	msetI.add(1);
	msetI.add(1);

	////////////////////////////////
	map<string,string>	mapping;

	mapping.add( "a", "b" );
	mapping.add( "a", "b" );

	////////////////////////////////
	mmap<string,string>	mmapping;

	mmapping.add( "a", "b" );
	mmapping.add( "a", "b" );

	////////////////////////////////
	list<i32>		listI;

	listI.append(1);
	listI.append(2);

	////////////////////////////////
	dlist<i32>	dlistI;

	dlistI.prepend(1);
	dlistI.prepend(2);
	dlistI.prepend(4);
	dlistI.prepend(4);

	////////////////////////////////
	stack<i32>	stackI;

	stackI.push(1);
	auto s = stackI.top();
	stackI.pop();

	////////////////////////////////
	queue<i32>	queueI;

	queueI.push(1);
	
	////////////////////////////////
	pqueue<i32> * pqueueI = new pqueue<i32>(cmp);

	pqueueI->push(1);

	////////////////////////////////
	dqueue<i32> dqueueI;
	
	dqueueI.push(1);

	return 0;
}
