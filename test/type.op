

interface BI <T,U>
{
}

interface I <T,U> implement BI<T,U>
{
}

union U 
{
	i32 i;
	f32 f;
}

type BT = class
{
	inline void foo() 
	{
	}

	inline void bar( final i32 i, inline f32 f ) 
	{
	}
}

type T = class <x> extend BT
{
	T ( args )
	{
	}

	~T ( ) 
	{
	}

	inline override void foo() 
	{
	}

	final void noexcept bar()
	{
	}

	private	atomic x x_;
	thread_local i32 i;
}
