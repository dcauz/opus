i32 main( i32 argc, final string [] argv )
{
	try 
		throw 1;
	catch( i32 ex )
	{
		puts( "caught i32" );
	}

	try 
	{
		if( argc == 1 )
			throw "s";
		else
			throw 1.1;
	}
 	catch( i32 ex )
	{
		puts( "caught i32" );
	}
	catch( string ex )
		puts( "caught string" );
	catch( ... )
	{
		puts( "caught unknown type" );
	}

	return 0;
}
