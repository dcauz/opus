	i--;
	i++;

    i = i ^ 1111;
	i ^= i;
    i = i ^^ 1111;
	i ^^= i;

    i = i & 2321;
	i &= i;

    i = i && 2321;
	i &&= i;

	v = v | nv;
	i |= i;

	v = v || nv;
	i ||= i;

	i = i!;

	int8 ? x;
	bool v = isvoid x;
	bool nv =  !v;
	nv =  ~v;
	nv ~=  v;
	
	i32 j = 123;

