i32 main( i32 argc, final string [] argv )
{
	switch ( argc )
	{
	case 0:
		puts("0");
		break;
	case 1:
	case 2:
		puts("1");
		break;
	default:
		puts("2");
		break;
	}

	switch ( int32 i = argc*2+8 )
	{
	case 8:
	{
		puts("0");
		break;
	}
	case 10:
		puts("1");
		break;
	default:
		puts("2");
		break;
	}

	return 0;
}
