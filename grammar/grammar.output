Grammar

    0 $accept: program $end

    1 program: imports statements
    2        | statements

    3 imports: imports import
    4        | import

    5 import: "import" STRING_LIT

    6 statements: statement
    7           | "ID" ':' statement
    8           | statements statement
    9           | statements "ID" ':' statement

   10 statement: ';'
   11          | declaration ';'
   12          | block
   13          | return ';'
   14          | exp ';'
   15          | for
   16          | namespace
   17          | while
   18          | switch
   19          | case
   20          | "break" ';'
   21          | "break" "ID" ';'
   22          | "continue" ';'
   23          | "continue" "ID" ';'
   24          | do_while
   25          | if_then_else
   26          | try_catch
   27          | assert
   28          | relationalExpr
   29          | using

   30 using: "using" "ID" '=' typeName ';'

   31 relationalExpr: "delete" "from" "ID" "where" exp ';'
   32               | "insert" "into" "ID" '(' nameList ')' "values" '(' expList ')' ';'
   33               | "update" "ID" "set" colAssignList "where" exp ';'

   34 nameList: nameList ',' "ID"
   35         | "ID"

   36 colAssignList: colAssignList ',' colAssign
   37              | colAssign

   38 colAssign: "ID" '=' exp

   39 expList: expList ',' exp
   40        | exp

   41 return: "return"
   42       | "return" exp
   43       | "co_return"
   44       | "co_return" exp

   45 assert: "assert" '(' exp ')'
   46       | "assert" '(' exp ',' STRING_LIT ')'

   47 if_then_else: "if" '(' exp ')' statement
   48             | "if" '(' exp ')' statement "else" statement

   49 switch: "switch" '(' exp ')' block

   50 namespace: "namespace" "ID" block

   51 block: '{' statements '}'
   52      | "atomic" '{' statements '}'

   53 case: "case" exp ':'
   54     | "case" exp ".." exp ':'
   55     | "default" ':'
   56     | "case" exp ':' statement
   57     | "case" exp ".." exp ':' statement
   58     | "default" ':' statement

   59 for: "for" '(' opt_for_init ';' opt_for_con ';' opt_for_inc ')' statement

   60 opt_for_init: %empty
   61             | typeName "ID" '=' exp

   62 opt_for_con: %empty
   63            | exp

   64 opt_for_inc: %empty
   65            | exp

   66 while: "while" '(' exp ')' statement

   67 do_while: "do" statement "while" '(' exp ')'

   68 try_catch: "try" statement catches

   69 catches: "catch" statement
   70        | catches "catch" statement

   71 exp: "ID"
   72    | '!' exp
   73    | '~' exp
   74    | '+' exp
   75    | '-' exp
   76    | '*' exp
   77    | '^' exp
   78    | "++" exp
   79    | "--" exp
   80    | exp '!'
   81    | exp "++"
   82    | exp "--"
   83    | exp '+' exp
   84    | exp '-' exp
   85    | exp '%' exp
   86    | exp '*' exp
   87    | exp '/' exp
   88    | exp '.' exp
   89    | exp '<' exp
   90    | exp '>' exp
   91    | exp '|' exp
   92    | exp '^' exp
   93    | exp '&' exp
   94    | lexp '=' exp
   95    | lexp ":=" exp
   96    | lexp "+=" exp
   97    | lexp "-=" exp
   98    | lexp "~=" exp
   99    | lexp "%=" exp
  100    | lexp "*=" exp
  101    | lexp "/=" exp
  102    | lexp "**=" exp
  103    | lexp "&=" exp
  104    | lexp "|=" exp
  105    | lexp "^=" exp
  106    | lexp "<<=" exp
  107    | lexp ">>=" exp
  108    | lexp "[.]=" exp
  109    | lexp "[*]=" exp
  110    | lexp "[/]=" exp
  111    | lexp "[**]=" exp
  112    | exp "**" exp
  113    | exp ".*" exp
  114    | exp "->" exp
  115    | exp "->*" exp
  116    | exp "<=" exp
  117    | exp ">=" exp
  118    | exp "<=>" exp
  119    | exp "==" exp
  120    | exp "!=" exp
  121    | exp "&&" exp
  122    | exp "||" exp
  123    | exp "<<" exp
  124    | exp ">>" exp
  125    | exp "[.]" exp
  126    | exp "[*]" exp
  127    | exp "[/]" exp
  128    | exp "[**]" exp
  129    | exp "join" exp
  130    | exp "left" "join" exp
  131    | exp "right" "join" exp
  132    | exp "outer" "join" exp
  133    | exp "in" exp
  134    | exp '?' exp ':' exp
  135    | '|' exp '|'
  136    | "throw" exp
  137    | "sizeof" exp
  138    | "alignof" exp
  139    | "alignas" exp
  140    | "is_void" exp
  141    | "new" exp
  142    | "delete" exp
  143    | "apply" exp exp
  144    | "closure" exp
  145    | "filter" exp exp
  146    | "reduce" exp exp
  147    | "order" exp exp
  148    | "order" rel_op exp
  149    | "order" exp
  150    | "eval" exp
  151    | "co_await" exp
  152    | "co_yield" exp
  153    | "async" exp
  154    | exp '[' exp_list ']'
  155    | exp '[' exp_list ".." exp_list ']'
  156    | exp '[' exp_list ".." ']'
  157    | exp '[' ".." exp_list ']'
  158    | typeName '(' exp_list ')'
  159    | "ID" '(' exp_list ')'
  160    | lambda
  161    | literal
  162    | "select" optDistinct optTop colList "from" nameList optWhere optGroupBy optHaving

  163 colList: colList ',' col
  164        | col

  165 col: '*'
  166    | exp
  167    | exp "as" "ID"

  168 optDistinct: %empty
  169            | "distinct"

  170 optTop: %empty
  171       | "top" exp
  172       | "top" exp "percent"
  173       | "top" exp "with" "ties"
  174       | "top" exp "percent" "with" "ties"

  175 optWhere: %empty
  176         | "where" exp

  177 optGroupBy: %empty
  178           | "group" "by" exp

  179 optHaving: %empty
  180          | "having" exp

  181 lexp: "ID"
  182     | lexp '[' exp ']'
  183     | lexp '.' "ID"
  184     | '*' lexp

  185 exp_list: exp_list ',' exp
  186         | exp

  187 declaration: modifiers type_def "ID" opt_args opt_fun_qual opt_init
  188            | modifiers type_def op opt_args opt_fun_qual opt_init
  189            | "type" "ID" '=' typeName
  190            | userDefinedType
  191            | function

  192 function: "for" '(' params ')' eleExpr

  193 params: params ',' typeName "ID"
  194       | typeName "ID"

  195 eleExpr: "ID" optDers
  196        | INT_LIT
  197        | eleExpr '+' eleExpr
  198        | eleExpr '/' eleExpr
  199        | eleExpr '+' eleExpr

  200 optDers: %empty
  201        | optDers '\''
  202        | '\''

  203 op: '*'
  204   | '+'
  205   | '-'
  206   | '/'

  207 opt_fun_qual: %empty
  208             | "override"
  209             | "final"
  210             | "noexcept"

  211 opt_init: '=' exp
  212         | '{' exp_list '}'
  213         | '{' statements '}'

  214 opt_args: %empty
  215         | args

  216 args: args ',' type_def
  217     | type_def

  218 type_def: typeName
  219         | typeName ptr_ops

  220 ptr_ops: '*'
  221        | '^'
  222        | '#'
  223        | '?'

  224 typeName: "Z"
  225         | "Z" zrange
  226         | "N"
  227         | "N" nrange
  228         | "Q"
  229         | "Q" qrange
  230         | "R"
  231         | "R" rrange
  232         | "C"
  233         | "C" base_type
  234         | "floatn"
  235         | "date"
  236         | "datetime"
  237         | "time"
  238         | "i32"
  239         | "z32"
  240         | "n32"
  241         | "u32"
  242         | "set" '<' typeName '>'
  243         | "mset" '<' typeName '>'
  244         | "map" '<' typeName ',' typeName '>'
  245         | "mmap" '<' typeName ',' typeName '>'
  246         | "heap" '<' typeName '>'
  247         | "list" '<' typeName '>'
  248         | "queue" '<' typeName '>'
  249         | "stack" '<' typeName '>'
  250         | typeName '[' exp_list ']'
  251         | "void"
  252         | "object"
  253         | "bool"
  254         | "char"
  255         | "string"
  256         | "lstring"
  257         | "ltstring"
  258         | "regexp"
  259         | "graph"
  260         | "auto"
  261         | "enum" "ID" enum_def
  262         | typeName '+' typeName
  263         | "mutex"
  264         | "semaphore"
  265         | "ID"

  266 enum_def: '{' enum_member_list '}'

  267 enum_member_list: "ID" opt_init
  268                 | enum_member_list ',' "ID" opt_init

  269 opt_init: %empty
  270         | '=' exp

  271 zrange: '<' INT_LIT ',' INT_LIT '>'

  272 rrange: '[' REAL_LIT ',' REAL_LIT ']'
  273       | '[' REAL_LIT ',' REAL_LIT ')'
  274       | '(' REAL_LIT ',' REAL_LIT ']'
  275       | '(' REAL_LIT ',' REAL_LIT ')'

  276 nrange: '<' INT_LIT '>'

  277 qrange: '<' numeric_type ',' numeric_type '>'

  278 numeric_type: "i32"
  279             | "z32"
  280             | "u32"
  281             | "n32"
  282             | "Z"
  283             | "N"

  284 base_type: '<' numeric_type '>'

  285 modifiers: "atomic"
  286          | "thread_local"
  287          | "const"
  288          | "mutable"
  289          | "public"
  290          | "private"
  291          | "class"
  292          | "pure"

  293 userDefinedType: "union" complex_type_def
  294                | "class" complex_type_def
  295                | "relation" relation_def
  296                | "interface" complex_type_def
  297                | typeName '*'
  298                | typeName '^'
  299                | typeName '%'
  300                | typeName '&'

  301 relation_def: '{' declarations '}'
  302             | "extend" extends '{' declarations '}'

  303 extends: %empty
  304        | extends ',' "ID"
  305        | "ID"

  306 complex_type_def: implements_extends '{' declarations '}'

  307 declarations: %empty
  308             | declarations declaration
  309             | declaration

  310 implements_extends: implements_extends "implement" implements
  311                   | implements_extends "extend" extends
  312                   | "implement" implements
  313                   | "extend" extends

  314 implements: implements ',' "ID"
  315           | "ID"

  316 lambda: '\\' '(' args ')' statement

  317 literal: INT_LIT
  318        | NAT_LIT
  319        | Q_LIT
  320        | REAL_LIT
  321        | "true"
  322        | "false"
  323        | DATETIME_LIT
  324        | TIME_LIT
  325        | FLOAT_LIT
  326        | STRING_LIT
  327        | LSTRING_LIT
  328        | LTSTRING_LIT
  329        | RE_LIT
  330        | CHAR_LIT
  331        | YEARS_LIT
  332        | MONS_LIT
  333        | DAYS_LIT
  334        | HOURS_LIT
  335        | MINS_LIT
  336        | SECS_LIT
  337        | '[' seq_exp_list ']'
  338        | '{' exp_list '}'
  339        | '{' nv_list '}'
  340        | '{' tuple_list '}'
  341        | ".pi"
  342        | ".e"
  343        | ".gamma"
  344        | ".phi"
  345        | ".i"
  346        | ".inf"
  347        | ".nan"

  348 nv_list: %empty
  349        | exp ':' exp
  350        | nv_list ',' exp ':' exp

  351 seq_exp_list: %empty
  352             | seq_exp_list exp

  353 tuple_list: tuple_list ',' tuple
  354           | tuple

  355 tuple: '<' nv_list '>'

  356 rel_op: ">="
  357       | "<="
  358       | '>'
  359       | '<'


